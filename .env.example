DATABASE_URL=postgresql://forecast:forecast@postgres:5432/forecast
IBKR_BASE_URL=https://forecasttrader.interactivebrokers.ie
IBKR_PUBLIC_PREFIX=/tws.proxy/public
IBKR_EXCHANGE=FORECASTX
SEED_UNDERLYING_CONID=
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=5
HTTP_RETRY_BACKOFF_SECONDS=1
HTTP_REQUESTS_PER_SECOND=1
HISTORY_PERIODS=1week,1month
LOG_LEVEL=INFO
TZ=UTC

# --- local analysis only (not used by the collector) ---
# FRED API key for analysis/collect_fred.py
FRED_API_KEY=
# VPS connection for scripts/refresh_data.sh (values in RUNBOOK.local.md)
PROD_HOST=
PROD_USER=
PROD_REPO_DIR=
PROD_SSH_KEY=~/.ssh/forecast_prod_deploy
PROD_SSH_PORT=22

